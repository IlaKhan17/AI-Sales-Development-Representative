# Frontend env (Next.js). All three are validated by lib/env.ts at startup —
# a missing var fails the build with a clear message rather than at runtime.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL used for Supabase OAuth callbacks (GitHub/Google sign-in).
NEXT_PUBLIC_URL=http://localhost:3000

# Optional: only needed if a server component reads the shared Redis cache.
REDIS_URL=redis://localhost:6379
