# ─── Required ────────────────────────────────────────────────────────────────
# The app refuses to boot without these.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>

# ─── Strongly recommended ────────────────────────────────────────────────────
# Service-role key: the backend bypasses RLS and filters by workspace itself.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# JWT secret enables local (network-free) token verification. Without it the
# backend falls back to a per-request supabase.auth.get_user() call.
SUPABASE_JWT_SECRET=<jwt secret from Supabase > Settings > API>
# Direct Postgres URL (session-mode pooler) — needed by the LangGraph
# checkpointer and to run migrations with psql.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-4.1-mini
PINECONE_API_KEY=<pinecone key>

# One Redis URL for cache, arq worker queue, and send-rate counters.
# Use rediss:// for TLS.
REDIS_URL=redis://localhost:6379

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ENV=dev

# ─── Google (Gmail send/read + Calendar) ─────────────────────────────────────
GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ─── Discovery sources (optional; each degrades gracefully) ──────────────────
SERP_API_KEY=<serpapi key>
# Optional email-finder fallback. NOT required: the built-in discovery
# (pattern permutation + MX lookup) already yields "likely" confidence for
# common patterns, which passes the send policy.
# Hunter requires a business email to sign up. Alternatives with free tiers
# that accept personal Gmail: Prospeo (75/mo, no card), Apollo.io, RocketReach.
# Leave empty to rely on the built-in logic only.
HUNTER_API_KEY=

# ─── Meeting bot (MeetingBaaS) ───────────────────────────────────────────────
# Also used as the shared secret for the inbound /webhook. Requests are
# rejected outright when this is unset.
BOT_API_KEY=<meetingbaas key>

# ─── Tracing / evals ─────────────────────────────────────────────────────────
BRAINTRUST_API_KEY=<braintrust key>
